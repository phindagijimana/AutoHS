#!/usr/bin/env bash
# AutoHS — Workflow CLI
# Manage installation, validation, and logs for the AutoHS pipeline spec.

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"

LOG_DIR="$ROOT/logs"
LOG_FILE="$LOG_DIR/autohs.log"
PID_FILE="$LOG_DIR/autohs.pid"
VENV="$ROOT/venv"
REQUIREMENTS="$ROOT/workflow/requirements.txt"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

log_info()  { echo -e "${BLUE}[INFO]${NC} $*"; }
log_ok()    { echo -e "${GREEN}[OK]${NC} $*"; }
log_warn()  { echo -e "${YELLOW}[WARN]${NC} $*"; }
log_error() { echo -e "${RED}[ERROR]${NC} $*" >&2; }

timestamp() { date '+%Y-%m-%d %H:%M:%S'; }

python_bin() {
  if [[ -x "$VENV/bin/python" ]]; then
    echo "$VENV/bin/python"
  else
    echo "python3"
  fi
}

ensure_log_dir() {
  mkdir -p "$LOG_DIR"
}

append_log() {
  ensure_log_dir
  echo "[$(timestamp)] $*" >> "$LOG_FILE"
}

usage() {
  cat <<EOF
AutoHS — Automated Hippocampal Sclerosis Workflow CLI

Usage:
  ./AutoHS install          Install Python deps and validate pipeline
  ./AutoHS build            Build ai-compute Docker image (step 2)
  ./AutoHS submit <nii>     Submit T1 NIfTI job to queue
  ./AutoHS submit --fastsurfer <nii>   Submit with FastSurfer (faster)
  ./AutoHS run              Run pending job when resources available
  ./AutoHS queue            List jobs in queue
  ./AutoHS start            Validate workflow and run unit tests
  ./AutoHS logs             Show workflow log output
  ./AutoHS stop             Stop background watch mode (if running)
  ./AutoHS status           Show install, resources, and validation status

Workflow (2 steps):
  1. Segmentation            FreeSurfer (default) or FastSurfer (--fastsurfer)
  2. AI-compute             (Docker: autohs/ai-compute:latest)

Examples:
  ./AutoHS install && ./AutoHS build
  ./AutoHS submit scan_T1w.nii.gz
  ./AutoHS submit --fastsurfer scan_T1w.nii.gz
  ./AutoHS run
  ./AutoHS queue
EOF
}

cmd_build() {
  if ! command -v docker &>/dev/null; then
    log_error "docker is required to build ai-compute"
    exit 1
  fi
  log_info "Building ai-compute container..."
  docker compose build ai-compute
  log_ok "Built autohs/ai-compute:latest"
  append_log "build ai-compute completed"
}

cmd_submit() {
  local input_file=""
  local fastsurfer=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --fastsurfer)
        fastsurfer=1
        shift
        ;;
      -h|--help)
        echo "Usage: ./AutoHS submit [--fastsurfer] <file.nii|file.nii.gz>"
        exit 0
        ;;
      -*)
        log_error "Unknown option: $1"
        exit 1
        ;;
      *)
        if [[ -n "$input_file" ]]; then
          log_error "Unexpected argument: $1"
          exit 1
        fi
        input_file="$1"
        shift
        ;;
    esac
  done
  if [[ -z "$input_file" ]]; then
    log_error "Usage: ./AutoHS submit [--fastsurfer] <file.nii|file.nii.gz>"
    exit 1
  fi
  PY="$(python_bin)"
  job_id=$($PY -c "
from pathlib import Path
from workflow.runner import WorkflowRunner
runner = WorkflowRunner(Path('$ROOT'))
print(runner.submit(Path('$input_file'), fastsurfer=bool($fastsurfer)))
")
  if [[ "$fastsurfer" -eq 1 ]]; then
    log_ok "Submitted job $job_id (FastSurfer)"
  else
    log_ok "Submitted job $job_id"
  fi
  append_log "submitted job $job_id fastsurfer=$fastsurfer"
  echo "  Run: ./AutoHS run"
  echo "  Or:  sbatch --job-name=autohs scripts/sbatch_run_job.sh $job_id$([[ $fastsurfer -eq 1 ]] && echo ' --fastsurfer')"
}

cmd_run() {
  PY="$(python_bin)"
  append_log "run invoked"
  $PY -c "
from pathlib import Path
from workflow.runner import WorkflowRunner
runner = WorkflowRunner(Path('$ROOT'))
job_id = runner.run_pending_if_resources_available()
if job_id:
    print(f'Completed run for job {job_id}')
else:
    print('No job started (queue empty or resources unavailable)')
" 2>&1 | tee -a "$LOG_FILE"
}

cmd_queue() {
  PY="$(python_bin)"
  $PY -c "
from pathlib import Path
from workflow.runner import WorkflowRunner
from workflow.resources import assess_resources
runner = WorkflowRunner(Path('$ROOT'))
jobs = runner.queue.list_jobs()
print('ID        SEG        STATUS     STEP                  PROGRESS  INPUT')
print('-' * 82)
for j in jobs:
    inp = Path(j.input_path).name
    seg = (getattr(j, 'segmentation', 'freesurfer') or 'freesurfer')[:10]
    print(f'{j.id:<8}  {seg:<10}  {j.status:<9}  {(j.step or \"-\"):<20}  {j.progress:>3}%      {inp}')
status = assess_resources(runner.data_dir, runner.queue.count_by_status('running'))
print()
print('Resources:', 'READY' if status.ok else 'NOT READY')
for r in status.reasons:
    print(' -', r)
"
}

cmd_install() {
  log_info "Installing AutoHS workflow dependencies..."
  ensure_log_dir
  append_log "install started"

  if ! command -v python3 &>/dev/null; then
    log_error "python3 is required but not found"
    exit 1
  fi

  if [[ ! -d "$VENV" ]]; then
    log_info "Creating virtual environment at venv/"
    python3 -m venv "$VENV"
  fi

  log_info "Installing packages from workflow/requirements.txt"
  "$VENV/bin/pip" install --upgrade pip -q
  "$VENV/bin/pip" install -r "$REQUIREMENTS" -q

  log_info "Validating pipeline definitions..."
  if "$VENV/bin/python" -m workflow.validate >> "$LOG_FILE" 2>&1; then
    log_ok "Install complete — pipeline validation passed"
    append_log "install completed successfully"
  else
    log_error "Pipeline validation failed — see ./AutoHS logs"
    append_log "install failed validation"
    exit 1
  fi
}

cmd_start() {
  ensure_log_dir
  PY="$(python_bin)"

  if [[ ! -x "$VENV/bin/python" ]] && ! $PY -c "import yaml" 2>/dev/null; then
    log_warn "Dependencies not installed — running install first"
    cmd_install
    PY="$(python_bin)"
  fi

  log_info "Starting AutoHS workflow (validate + test)..."
  append_log "start invoked"

  {
    echo "=== AutoHS start $(timestamp) ==="
    $PY -m workflow.validate
    echo ""
    $PY -m unittest workflow.tests.test_workflow -v
    echo "=== AutoHS start complete $(timestamp) ==="
  } 2>&1 | tee -a "$LOG_FILE"

  log_ok "Workflow started — validation and tests passed"
  append_log "start completed successfully"
}

cmd_logs() {
  ensure_log_dir
  if [[ ! -f "$LOG_FILE" ]]; then
    log_warn "No logs yet — run ./AutoHS install or ./AutoHS start first"
    exit 0
  fi

  if [[ "${1:-}" == "-f" ]] || [[ "${1:-}" == "--follow" ]]; then
    tail -f "$LOG_FILE"
  else
    tail -n 80 "$LOG_FILE"
  fi
}

cmd_stop() {
  ensure_log_dir
  if [[ -f "$PID_FILE" ]]; then
    pid="$(cat "$PID_FILE")"
    if kill -0 "$pid" 2>/dev/null; then
      kill "$pid" 2>/dev/null || true
      log_ok "Stopped background process (PID $pid)"
      append_log "stop killed pid $pid"
    else
      log_warn "Stale PID file — no process running"
    fi
    rm -f "$PID_FILE"
  else
    log_info "Nothing to stop — AutoHS start runs synchronously (no daemon)"
    append_log "stop called — no daemon active"
  fi
}

cmd_status() {
  PY="$(python_bin)"
  echo "AutoHS status"
  echo "  Root:       $ROOT"
  echo "  Python:     $PY"
  echo "  Venv:       $([ -d "$VENV" ] && echo "installed" || echo "not installed")"
  echo "  Log file:   $LOG_FILE"

  if [[ -f "$PID_FILE" ]] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
    echo "  Daemon:     running (PID $(cat "$PID_FILE"))"
  else
    echo "  Daemon:     not running"
  fi

  echo ""
  if $PY -c "import yaml" 2>/dev/null; then
    log_ok "PyYAML available"
  else
    log_warn "PyYAML not installed — run ./AutoHS install"
    exit 1
  fi

  echo ""
  $PY -m workflow.validate
}

main() {
  local cmd="${1:-}"
  shift || true

  case "$cmd" in
    install) cmd_install "$@" ;;
    build)   cmd_build "$@" ;;
    submit)  cmd_submit "$@" ;;
    run)     cmd_run "$@" ;;
    queue)   cmd_queue "$@" ;;
    start)   cmd_start "$@" ;;
    logs)    cmd_logs "$@" ;;
    stop)    cmd_stop "$@" ;;
    status)  cmd_status "$@" ;;
    -h|--help|help|"")
      usage
      ;;
    *)
      log_error "Unknown command: $cmd"
      echo ""
      usage
      exit 1
      ;;
  esac
}

main "$@"
